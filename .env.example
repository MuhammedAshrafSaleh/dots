APP_NAME=DOTS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://dots.test

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_EG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Logging: production should keep rolling daily logs with retention and raise
# LOG_LEVEL to `warning`. Deprecations go to their own channel so they don't
# drown the main log.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dots
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Image conversions: Imagick keeps pixel buffers outside PHP's memory_limit and
# produces better WebP than GD. Requires the imagick PHP extension (fallback: gd).
IMAGE_DRIVER=imagick

# Cache: Redis in production. If Redis is not running locally, fall back with
# CACHE_STORE=database (and QUEUE_CONNECTION=sync) — both work without Redis.
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis is a pure-PHP client (no phpredis extension needed). Switch to
# phpredis in production if the extension is available for better throughput.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@dots.test"
MAIL_FROM_NAME="DOTS"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backups (spatie/laravel-backup). Local disk is active by default; set
# BACKUP_DISK=google-drive once the Google Drive credentials below are filled in.
BACKUP_DISK=local
BACKUP_NOTIFICATION_EMAIL=admin@dots.test
BACKUP_ARCHIVE_PASSWORD=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Leave empty — our code creates the backup folder on first write (drive.file scope).
GOOGLE_DRIVE_FOLDER=

VITE_APP_NAME="${APP_NAME}"

# Paymob (Intention / Unified Checkout). Leave empty to disable card payment.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID_CARD=
PAYMOB_HMAC_SECRET=

# Seeded admin account (RolesAndAdminSeeder). Set these before seeding in production.
ADMIN_EMAIL=
ADMIN_PASSWORD=
